{
  "name": "hstool-offline",
  "productName": "HStool",
  "version": "1.0.0",
  "description": "红石的小站 · 离线工具集",
  "author": "HSDL03",
  "license": "MIT",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^32.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.github.hsdl03.hstool",
    "productName": "HStool离线版",
    "directories": { "output": "dist", "buildResources": "build" },
    "files": ["main.js", "preload.js", "www/**/*"],
    "win": {
      "target": [{ "target": "portable", "arch": ["x64"] }],
      "icon": "build/icon.ico",
      "artifactName": "HStool-Offline-${version}.exe"
    },
    "portable": { "artifactName": "HStool-Offline-${version}.exe", "requestExecutionLevel": "user" },
    "compression": "maximum"
  }
}
